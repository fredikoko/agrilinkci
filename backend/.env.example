# Django
DJANGO_SECRET_KEY=remplacer-par-une-cle-aleatoire
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# SMS : console pour le développement, twilio pour la production
SMS_PROVIDER=console
SMS_COUNTRY_CODE=CI
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=60

# Obligatoire uniquement si SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=remplacer-par-le-token-twilio
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# E-mail : console en développement, SMTP en production
DEFAULT_FROM_EMAIL=no-reply@agrilink.ci
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.exemple.ci
EMAIL_PORT=587
EMAIL_HOST_USER=utilisateur-smtp
EMAIL_HOST_PASSWORD=mot-de-passe-smtp
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

# Chariow Payments API (https://chariow.com / https://chariow.dev)
# Votre clé secrète API Chariow (sk_live_... ou sk_test_...)
CHARIOW_API_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
# Secret de signature des webhooks (Pulses) Chariow
CHARIOW_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx
CHARIOW_BASE_URL=https://api.chariow.com/v1
CHARIOW_CURRENCY=XOF
# ID du produit abonnement vendeur créé sur votre boutique Chariow
CHARIOW_SELLER_PRODUCT_ID=prd_vendeur_mensuel
# IDs des produits Conseil Pro sur votre boutique Chariow
CHARIOW_CONSEIL_PRODUCT_ID=prd_conseil_mensuel
CHARIOW_CONSEIL_ANNUAL_PRODUCT_ID=prd_conseil_annuel
CHARIOW_SUBSCRIPTION_AMOUNT=5000
CHARIOW_SUBSCRIPTION_DAYS=30
CHARIOW_CALLBACK_URL=https://api.exemple.ci/payments/subscription/status/


# Redis / Cache (ex. service Redis sur Railway)
REDIS_URL=redis://default:mot-de-passe@hote:6379

# Firebase Cloud Messaging (compte de service JSON minifié sur une seule ligne)
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Sentry (Observabilité et suivi d'erreurs en production)
SENTRY_DSN=https://xxxxxxxx@o0.ingest.sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=0.1

# Logs
DJANGO_LOG_LEVEL=INFO

# Railway / production
DATABASE_URL=postgresql://utilisateur:mot-de-passe@hote:5432/base
DJANGO_DEBUG=false
RAILWAY_PUBLIC_DOMAIN=agrilink-production.up.railway.app
DJANGO_ALLOWED_HOSTS=agrilink-production.up.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://agrilink-production.up.railway.app
DJANGO_HSTS_SECONDS=31536000

# Stockage persistant des médias (optionnel : Cloudflare R2, AWS S3, Supabase Storage)
# Si non configuré, le stockage local FileSystemStorage est utilisé.
# AWS_ACCESS_KEY_ID=votre-cle-acces
# AWS_SECRET_ACCESS_KEY=votre-cle-secrete
# AWS_STORAGE_BUCKET_NAME=agrilink-media
# AWS_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# AWS_S3_REGION_NAME=auto

# Railway fournit automatiquement PORT et RAILWAY_PUBLIC_DOMAIN.


